<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações de build, segurança e metadados comuns: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>TEC.Cofre.AzureKeyVault</RootNamespace>
    <PackageId>TEC.Cofre.AzureKeyVault</PackageId>
    <Version>0.0.1</Version>
    <Description>Provedor Azure Key Vault do TEC.Cofre: secrets, chaves (criptografia sem a chave sair do cofre) e certificados, com autenticação sem segredos (Managed Identity / Workload Identity), validação do endereço do cofre e mapeamento de erros para Result.</Description>
    <PackageTags>vault;secrets;keyvault;azure;cofre;zero-trust;tec</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" Version="4.9.1" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" Version="4.10.1" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Cofre\TEC.Cofre.csproj" />
  </ItemGroup>

</Project>
