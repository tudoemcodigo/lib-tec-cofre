<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações de build, segurança e metadados comuns: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>TEC.Cofre</RootNamespace>
    <PackageId>TEC.Cofre</PackageId>
    <Version>0.0.1</Version>
    <Description>Abstração padronizada de cofres de segredos (secrets, chaves criptográficas e certificados) sobre o TEC.Core: API com Result, validação de entrada, auditoria em log sem valores, OpenTelemetry, cache opcional, provedor de IConfiguration, health check, geração/rotação de segredos e criptografia envelope. Independente de nuvem: use com um provedor (ex.: TEC.Cofre.AzureKeyVault).</Description>
    <PackageTags>vault;secrets;keyvault;cofre;zero-trust;tec</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    TEC.Core: sempre o pacote do feed interno (ver ..\nuget.config: packageSourceMapping garante que TEC.* nunca seja
    baixado do nuget.org). Por enquanto uma prévia, até a 0.0.1 estável ser publicada; uma única referência, sem condição
    (duas referências ao mesmo pacote geram NU1504 e deixam o lock file inconsistente).
    Este pacote NÃO depende de SDK de nuvem: cada provedor fica no seu próprio pacote.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="TEC.Core" Version="0.0.1-preview.5" />
  </ItemGroup>

</Project>
