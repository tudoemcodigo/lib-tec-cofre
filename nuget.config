<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Segurança da cadeia de suprimentos (dependency confusion): cada pacote só pode vir da origem mapeada.
    Pacotes TEC.* vêm exclusivamente do feed interno; o restante, do nuget.org.
    As origens "nuget.org" e "tec-interno" (URL e credenciais) são definidas no NuGet.Config do usuário ou do CI,
    com exatamente estes nomes. Nunca coloque credenciais neste arquivo.
  -->
  <packageSourceMapping>
    <packageSource key="tec-interno">
      <package pattern="TEC.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
